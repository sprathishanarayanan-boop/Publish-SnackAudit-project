# Copy to .env (or export) for local runs. Every value has a working local default.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tickets
# Set to true for managed Postgres that requires TLS on external connections
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
GATEWAY_WEBHOOK_SECRET=change-me-too

# Reservation engine
HOLD_MINUTES=10
HOLD_SWEEP_SECONDS=30
MAX_SEATS_PER_ORDER=10
# Run the hold-release job inside the web process (set false and run `npm run worker` to split)
RUN_JOBS_IN_WEB=true

# Caching (seconds)
EVENT_CACHE_TTL=300
AVAILABILITY_CACHE_TTL=5

# Mock payment gateway latency (ms)
GATEWAY_MIN_DELAY_MS=1500
GATEWAY_MAX_DELAY_MS=3500

# Demo data on first boot, and the admin-only test hook used by the Postman suite
SEED_DEMO=true
ENABLE_TEST_ROUTES=true
AUTH_RATE_LIMIT_PER_MIN=120
